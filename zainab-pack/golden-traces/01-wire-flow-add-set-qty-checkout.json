{
  "id": "golden-01-wire-add-qty-checkout",
  "title": "Wire flow: add → set quantity → checkout summary → submit demo order",
  "currency": "PKR",
  "item_id": "wrap-hot-chicken",
  "notes": [
    "Derived from Habiba contract/v1/examples (action_add_item, action_set_quantity, result_success, checkout_summary_without_token, checkout_submit_without_token).",
    "Website must return app.action_result correlated by action_id; bump revision on each successful mutation.",
    "confirmation_token is optional; this flow omits it (L8 default).",
    "Unit price for wrap-hot-chicken in catalog-seed.json is 850 PKR; service_fee_pkr may apply on cart totals in MockApp."
  ],
  "steps": [
    {
      "step": 1,
      "direction": "agent → app",
      "event": {
        "schema_version": "1.0",
        "session_id": "demo-session-7",
        "event_id": "event-add-1",
        "turn_id": "turn-15",
        "timestamp": "2026-10-02T12:00:00Z",
        "context_revision": 8,
        "type": "agent.action_request",
        "payload": {
          "action_id": "action-add-1",
          "operation": "cart.add_item",
          "arguments": {
            "item_id": "wrap-hot-chicken",
            "quantity": 2
          }
        }
      },
      "expected_result": {
        "type": "app.action_result",
        "payload": {
          "action_id": "action-add-1",
          "status": "success",
          "verified_state": {
            "cart": [
              {
                "item_id": "wrap-hot-chicken",
                "name": "Hot Chicken Wrap",
                "quantity": 2,
                "unit_price": 850
              }
            ],
            "currency": "PKR"
          }
        }
      }
    },
    {
      "step": 2,
      "direction": "agent → app",
      "event": {
        "schema_version": "1.0",
        "session_id": "demo-session-7",
        "event_id": "event-qty-1",
        "turn_id": "turn-16",
        "timestamp": "2026-10-02T12:00:01Z",
        "context_revision": 9,
        "type": "agent.action_request",
        "payload": {
          "action_id": "action-qty-1",
          "operation": "cart.set_quantity",
          "arguments": {
            "item_id": "wrap-hot-chicken",
            "quantity": 1
          }
        }
      },
      "expected_result": {
        "type": "app.action_result",
        "payload": {
          "action_id": "action-qty-1",
          "status": "success",
          "verified_state": {
            "cart": [
              {
                "item_id": "wrap-hot-chicken",
                "name": "Hot Chicken Wrap",
                "quantity": 1,
                "unit_price": 850
              }
            ],
            "currency": "PKR",
            "total": 850
          }
        }
      }
    },
    {
      "step": 3,
      "direction": "agent → app",
      "event": {
        "schema_version": "1.0",
        "session_id": "demo-session-7",
        "event_id": "event-sum-1",
        "turn_id": "turn-17",
        "timestamp": "2026-10-02T12:00:02Z",
        "context_revision": 10,
        "type": "agent.action_request",
        "payload": {
          "action_id": "action-sum-1",
          "operation": "checkout.get_summary",
          "arguments": {}
        }
      },
      "expected_result": {
        "type": "app.action_result",
        "payload": {
          "action_id": "action-sum-1",
          "status": "success",
          "verified_state": {
            "currency": "PKR",
            "total": 850
          }
        },
        "notes": "May include optional confirmation_token; if present, submit must echo it."
      }
    },
    {
      "step": 4,
      "direction": "agent → app",
      "event": {
        "schema_version": "1.0",
        "session_id": "demo-session-7",
        "event_id": "event-submit-1",
        "turn_id": "turn-18",
        "timestamp": "2026-10-02T12:00:03Z",
        "context_revision": 10,
        "type": "agent.action_request",
        "payload": {
          "action_id": "action-submit-1",
          "operation": "checkout.submit_demo_order",
          "arguments": {
            "confirmed": true
          }
        }
      },
      "expected_result": {
        "type": "app.action_result",
        "payload": {
          "action_id": "action-submit-1",
          "status": "success"
        },
        "notes": "Exactly one simulated demo order. No real payment. Replaying the same action_id must not create a second order."
      }
    }
  ]
}
