{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
      "title": "Timestamp",
      "type": "string"
    },
    "action_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "event_id",
    "timestamp",
    "action_id"
  ],
  "title": "LookupRequest",
  "type": "object"
}
