# Secrets — placeholders only. Copy to `.env` and fill locally. Never commit `.env`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GOOGLE_API_KEY=

# Shared capacity ledger. Required in Cloud; TLS Redis URL, never a REST URL.
GROQ_CAPACITY_REDIS_URL=
# Optional Redis-only resolver; leave blank for system DNS. Never disables TLS/DNSSEC.
GROQ_CAPACITY_DNS_SERVER=
# Local development only: SQLite coordinates processes on this one machine.
GROQ_CAPACITY_SQLITE_PATH=.cache/groq-capacity.sqlite3
GROQ_CAPACITY_NAMESPACE=foodease:groq:v1
# Four stable organization labels, one per key slot. Same organization => same label.
# For the user's Groq-approved separate accounts, use account1,account2,account3,account4
# and set INDEPENDENT_APPROVED=true only while that permission applies.
GROQ_CAPACITY_POOLS=shared,shared,shared,shared
GROQ_CAPACITY_INDEPENDENT_APPROVED=false
GROQ_CAPACITY_OUTPUT_TOKENS=1024
GROQ_CAPACITY_SAFETY_FACTOR=1.2
GROQ_CAPACITY_SAFETY_TOKENS=128
# Conservative bootstrap ceilings; verify against every account/model's limits.
# Use the lowest applicable limits among the configured pools.
GROQ_CAPACITY_TPM=8000
GROQ_CAPACITY_RPM=30
GROQ_CAPACITY_RPD=1000
GROQ_CAPACITY_TPD=200000
# Optional separate input/output TPM caps: 0 means not applicable.
GROQ_CAPACITY_ITPM=0
GROQ_CAPACITY_OTPM=0
GROQ_CAPACITY_STALE_SECONDS=60

# Non-secret runtime settings
ASSISTANT_LANGUAGE=ur
# Urdu uses Groq Whisper recognition and VAD; existing English STT settings remain below.
URDU_STT_MODEL=whisper-large-v3-turbo
STT_MODEL=flux-general-en
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
# Used when LLM_PROVIDER=gemini.
LLM_MODEL=gemini-3.1-flash-lite
LLM_THINKING_LEVEL=minimal
TTS_MODEL=sonic-3.6
# Optional. Set a valid Cartesia voice UUID to override the FoodEase default.
TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
IDLE_PROMPT_1_SECONDS=12
IDLE_PROMPT_2_SECONDS=30
RECORD_AUDIO=false
DEV_MODE=false
VOICE_PIPELINE_CONFIG=A
SNAPSHOT_TIMEOUT_SECONDS=2
PREEMPTIVE_GENERATION=false
NOISE_CANCELLATION=false
GREETING_CACHE=true

# Optional: LiveKit Agents worker name (default foodease). Must match orchestration FOODEASE_AGENT_NAME.
# FOODEASE_AGENT_NAME=foodease
# Topology rehearsal: mock (default in-process cart) | livekit (RPC to MockApp/Zainab in room)
# FOODEASE_APP_TRANSPORT=mock
# FOODEASE_ROOM=foodease-demo

# Phase 9 tuning (optional — defaults shown)
# INTERRUPTION_MIN_DURATION=0.5
# INTERRUPTION_MIN_WORDS=0
# INTERRUPTION_FALSE_TIMEOUT=2.0
# ENDPOINTING_MIN=0.45
# ENDPOINTING_MAX=3.0
