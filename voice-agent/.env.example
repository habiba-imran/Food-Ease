# Secrets — placeholders only. Copy to `.env` and fill locally. Never commit `.env`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Non-secret runtime settings
ASSISTANT_LANGUAGE=ur
# Urdu uses Groq Whisper recognition and VAD; existing English STT settings remain below.
URDU_STT_MODEL=whisper-large-v3-turbo
STT_MODEL=flux-general-en
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
# Used when LLM_PROVIDER=gemini.
LLM_MODEL=gemini-3.1-flash-lite
LLM_THINKING_LEVEL=minimal
TTS_MODEL=sonic-3.6
# Optional. Set a valid Cartesia voice UUID to override the FoodEase default.
TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
IDLE_PROMPT_1_SECONDS=12
IDLE_PROMPT_2_SECONDS=30
RECORD_AUDIO=false
DEV_MODE=false
VOICE_PIPELINE_CONFIG=A
SNAPSHOT_TIMEOUT_SECONDS=2
PREEMPTIVE_GENERATION=false
NOISE_CANCELLATION=false
GREETING_CACHE=true

# Optional: LiveKit Agents worker name (default foodease). Must match orchestration FOODEASE_AGENT_NAME.
# FOODEASE_AGENT_NAME=foodease
# Topology rehearsal: mock (default in-process cart) | livekit (RPC to MockApp/Zainab in room)
# FOODEASE_APP_TRANSPORT=mock
# FOODEASE_ROOM=foodease-demo

# Phase 9 tuning (optional — defaults shown)
# INTERRUPTION_MIN_DURATION=0.5
# INTERRUPTION_MIN_WORDS=0
# INTERRUPTION_FALSE_TIMEOUT=2.0
# ENDPOINTING_MIN=0.45
# ENDPOINTING_MAX=3.0
