# =============================================================================
# website/ - FoodEase app seat and accessible shopping UI
# Copy to .env only if you need local overrides. Never commit real secrets.
# =============================================================================

HOST=127.0.0.1
PORT=8080
APP_NAME=FoodEase

# Habiba orchestration service. Used later for LiveKit app/user tokens.
ORCHESTRATION_BASE_URL=http://127.0.0.1:8090

# Phase 1 reads the frozen pack catalog by relative path.
CATALOG_SEED_PATH=../zainab-pack/catalog-seed.json

# Development toggles. Keep mock tools visibly labelled when enabled.
ENABLE_MOCK_AGENT=true
ENABLE_3D=true
ENABLE_AR=false

