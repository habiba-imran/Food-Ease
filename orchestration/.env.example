# =============================================================================
# orchestration/ — Habiba session glue ONLY
# Copy to .env and fill. Never commit real secrets.
# Cart/menu stay on the app seat; voice brain stays in voice-agent/.
# See docs/OWNERSHIP.md
# =============================================================================

# LiveKit Cloud (required for mint + optional agent dispatch)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# Token / HTTP server
TOKEN_TTL_SECONDS=900
HOST=127.0.0.1
PORT=8090
# Browser origins allowed to call this API (harness / future website)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Demo rate limit (requests per IP per window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Consent / assist dispatch (WEB-01)
# When true, POST /v1/assist/start calls LiveKit CreateAgentDispatch
LIVEKIT_AGENT_DISPATCH=true
# Must match the LiveKit Agents worker name (voice-agent foodease-worker default)
FOODEASE_AGENT_NAME=foodease
